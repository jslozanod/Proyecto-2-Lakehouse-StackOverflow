# JupyterLab para correr a mano los notebooks de respaldo.
# Usa la misma instalación de Spark del clúster, con los mismos JARs y el mismo spark-defaults.conf.
FROM python:3.12-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless procps curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

COPY --from=sparkdist /opt/spark /opt/spark
ENV SPARK_HOME=/opt/spark
ENV PATH="/opt/spark/bin:${PATH}"

COPY requirements-jupyter.txt /tmp/requirements.txt
RUN i=0; until pip install --no-cache-dir -r /tmp/requirements.txt; do \
        i=$((i+1)); \
        if [ "$i" -ge 5 ]; then echo "pip fallo 5 veces, se aborta el build"; exit 1; fi; \
        echo "pip install fallo (intento $i), reintentando..."; sleep 5; \
    done

WORKDIR /workspace
EXPOSE 8888
