# Airflow 2.9.0 + Java 17 + la MISMA distribucion de Spark que usa el cluster.
# Asi spark-submit (SparkSubmitOperator) y el cluster comparten version, JARs
# (Iceberg, Nessie, S3) y spark-defaults.conf, y no se descarga nada en tiempo de ejecucion.
FROM apache/airflow:2.9.0

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless procps wget curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Distribucion de Spark construida en Dockerfile.spark (contexto adicional "sparkdist")
COPY --from=sparkdist /opt/spark /opt/spark
ENV SPARK_HOME=/opt/spark
ENV PATH="/opt/spark/bin:${PATH}"

USER airflow
COPY requirements-airflow.txt /tmp/requirements.txt
# Reintentos por si la conexion es inestable
RUN i=0; until pip install --no-cache-dir -r /tmp/requirements.txt; do \
        i=$((i+1)); \
        if [ "$i" -ge 5 ]; then echo "pip fallo 5 veces, se aborta el build"; exit 1; fi; \
        echo "pip install fallo (intento $i), reintentando..."; sleep 5; \
    done
