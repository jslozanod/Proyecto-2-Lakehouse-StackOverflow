# Imagen de Airflow 2.9.0 con Java 17 y la misma versión de Spark que usa el clúster.
# Así spark-submit (el SparkSubmitOperator) y el clúster tienen los mismos JARs (Iceberg, Nessie, S3)
# y el mismo spark-defaults.conf, y no hay que descargar nada cuando se ejecuta el pipeline.
FROM apache/airflow:2.9.0

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless procps wget curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Copiamos la instalación de Spark que se arma en Dockerfile.spark (en el compose se llama "sparkdist")
COPY --from=sparkdist /opt/spark /opt/spark
ENV SPARK_HOME=/opt/spark
ENV PATH="/opt/spark/bin:${PATH}"

USER airflow
COPY requirements-airflow.txt /tmp/requirements.txt
# Si la descarga falla por el internet inestable, reintenta hasta 5 veces antes de abortar el build
RUN i=0; until pip install --no-cache-dir -r /tmp/requirements.txt; do \
        i=$((i+1)); \
        if [ "$i" -ge 5 ]; then echo "pip fallo 5 veces, se aborta el build"; exit 1; fi; \
        echo "pip install fallo (intento $i), reintentando..."; sleep 5; \
    done
